{
  "name": "wasiai-a2a",
  "version": "0.1.0",
  "type": "module",
  "description": "A2A Protocol — Agent discovery, composition, and orchestration service",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && mkdir -p dist/static && cp -r src/static/. dist/static/",
    "start": "node dist/index.js",
    "lint": "biome check src/",
    "format": "biome format --write src/",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "smoke:downstream": "node scripts/smoke-downstream-x402.mjs",
    "migrate:preflight": "node scripts/migrate-preflight.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.98.4",
    "@supabase/supabase-js": "^2.111.0",
    "@x402/extensions": "2.20.0",
    "fastify": "^5.11.0",
    "pino": "^10.3.1",
    "undici": "^8.9.0",
    "viem": "^2.55.10"
  },
  "overrides": {
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ferrosasfp/wasiai-a2a.git"
  },
  "keywords": [
    "ai",
    "agents",
    "a2a",
    "discovery",
    "orchestration"
  ],
  "author": "WasiAI",
  "license": "MIT"
}
