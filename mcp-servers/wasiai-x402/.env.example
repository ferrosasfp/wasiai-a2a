# ─────────────────────────────────────────────────────────────────
# wasiai-x402 MCP server — example configuration
#
# Copy to .env and fill real values for local dev.
# In Claude Console managed env, set these via the env panel.
# Never commit .env (see .gitignore).
# ─────────────────────────────────────────────────────────────────

# === REQUIRED ===

# Operator wallet private key — funds the EIP-3009 signature on Kite testnet.
# Format: 0x-prefixed 32-byte hex (66 chars total, 64 hex digits).
# Example: 0x1111111111111111111111111111111111111111111111111111111111111111
# WARNING: this PK controls real value. Rotate immediately if leaked.
OPERATOR_PRIVATE_KEY=0xYourOperatorPrivateKey

# === GATEWAY ===

# WasiAI gateway URL (target of the x402 calls).
# Required: NO (defaults to https://app.wasiai.io with warn-once).
# Format: parseable URL, scheme https://. http://localhost only when NODE_ENV=development.
# Example: https://app.wasiai.io
WASIAI_GATEWAY_URL=https://app.wasiai.io

# Allowlist of hosts that bypass the SSRF private-IP guard.
# Required: NO (default empty = no bypass).
# Format: CSV of hostnames (no scheme, no port). Used in dev/staging only.
# Example: internal.example.com,staging.example.com
MCP_GATEWAY_ALLOWLIST=

# === KITE / x402 (defaults match prod) ===

# Kite testnet chain id (used in EIP-712 domain + envelope network field).
# Required: NO (default 2368). Set to 2366 for Kite mainnet (out-of-scope WKH-64).
KITE_CHAIN_ID=2368

# PYUSD contract address on Kite testnet.
# Required: NO (default 0x8E04D099b1a8Dd20E6caD4b2Ab2B405B98242ec9).
KITE_PYUSD=0x8E04D099b1a8Dd20E6caD4b2Ab2B405B98242ec9

# EIP-712 domain name for PYUSD (must match contract).
# Required: NO (default 'PYUSD').
X402_EIP712_DOMAIN_NAME=PYUSD

# EIP-712 domain version for PYUSD.
# Required: NO (default '1').
X402_EIP712_DOMAIN_VERSION=1

# === GUARDS ===

# Maximum amount in wei the server is willing to sign per pay_x402 call.
# Required: NO (default empty = no guard, NOT recommended in prod).
# Format: integer in wei (BigInt-parseable). Example for 1 PYUSD = 1000000000000000000.
# Per-call override available via input.maxAmountWei (priority: per-call > env > undefined).
MCP_MAX_AMOUNT_WEI_DEFAULT=

# Per-request timeout for HTTP calls to the gateway.
# Required: NO (default 30000 ms).
MCP_PAY_TIMEOUT_MS=30000

# === HTTP TRANSPORT (Vercel deploy — WKH-65) ===

# Bearer token for the HTTP transport (api/mcp.mjs).
# Required: YES when deploying api/mcp.mjs to Vercel. NOT used by the stdio
#           transport (npm start), so leave unset for local stdio dev.
# Format: hex 64 chars (256 bits). Generate with:
#   openssl rand -hex 32
# WARNING: never commit the real value. Anyone with this token can call the
# 3 tools and trigger payments. Rotate on suspected leak.
MCP_BEARER_TOKEN=your-secret-hex-64-chars-here

# CORS allowlist for the HTTP transport.
# Required: NO (default empty = deny all cross-origin).
# Format: CSV of explicit origins (scheme + host + port).
# Example: https://platform.claude.com,https://claude.ai
# Notes: Claude Console MCP clients typically proxy server-side, so leaving
# this empty is the safest default. Only set if you have a browser-based
# client that needs cross-origin access.
# NOTE: '*' is NOT supported as a wildcard. Only literal origin matches work.
#       To allow multiple origins, list them explicitly comma-separated.
MCP_CORS_ALLOWED_ORIGINS=

# === RUNTIME ===

# Standard Node env (controls strictness of SSRF guard for localhost).
# Required: NO (default 'production'). Set 'development' to allow http://localhost.
NODE_ENV=production

# === WKH-66 Production Hardening ===

# Cron auth shared secret — usado por cron-job.org Authorization: Bearer header
# OBLIGATORIO en producción. Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Balance gate threshold (USDC mainnet). Si balance < threshold → reject pay_x402 fail-secure.
# Default 0.50 USDC.
MCP_BALANCE_THRESHOLD_USDC=0.50

# Rate limit per bearer hash, per minute. Default 5.
MCP_RATE_LIMIT_PER_MIN=5

# TTL fixed-window rate limit (segundos). Default 60.
MCP_RATE_LIMIT_WINDOW_SEC=60

# TTL del balance snapshot KV usado por balance-guard (segundos). Default 30.
MCP_BALANCE_SNAPSHOT_TTL_SEC=30

# TTL del balance claim KV (segundos). PROHIBIDO > 60s (CD-13). Default 30.
MCP_BALANCE_CLAIM_TTL_SEC=30

# URL del webhook que recibe alertas critical. Generic POST JSON.
# Compatible Slack incoming webhook, Discord webhook, Datadog event.
# Si vacío → log-only (warnOnce).
MCP_ALERT_WEBHOOK_URL=

# RPC endpoint Avalanche C-Chain mainnet. Default: https://api.avax.network/ext/bc/C/rpc
AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc

# USDC contract address Avalanche C-Chain mainnet. Default: canonical Circle USDC.
AVALANCHE_USDC_ADDRESS=0xB97EF9Ef8734C71904D8002F8b6Bc66Dd9c48a6E

# Chain ID for balance reads. Default 43114 (Avalanche C-Chain mainnet).
MCP_OPERATOR_CHAIN_ID=43114

# Upstash Redis (Vercel KV) — provisioning vía Vercel Marketplace.
# Vercel inyecta automáticamente. kv-client.mjs lee con fallback al alias UPSTASH_REDIS_*.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=    # alternative env var name post-2024 integrations
# UPSTASH_REDIS_REST_TOKEN=  # idem

# cron-job.org API token — DEV LOCAL ONLY. NUNCA commitear. NO se setea en Vercel
# (cron-job.org llama a Vercel, no al revés). Se usa SOLO desde scripts/setup-cronjob.mjs.
CRONJOB_ORG_API_TOKEN=

# URL del deploy (para setup-cronjob.mjs). Ejemplo: https://wasiai-x402-mcp.vercel.app
MCP_DEPLOY_URL=

# === WKH-75 Headless Bearer Rotation ===

# Vercel API access for headless bearer rotation. Required by
# api/cron/rotate-bearer.mjs and api/cron/invalidate-prev-bearer.mjs.
# Generate at https://vercel.com/account/tokens with scope = the project
# (or team) hosting wasiai-x402. Treat as a high-privilege secret: with this
# token a caller can read AND write env vars + trigger redeploys.
# WARNING: never commit the real value. Rotate on suspected leak.
VERCEL_TOKEN=vercel_xxxxxxxxxx

# Vercel project ID (NOT the slug). Find it in Project → Settings → General.
# Format: prj_<random>.
VERCEL_PROJECT_ID=prj_xxxxxxxxxx

# Vercel team ID — REQUIRED only if the project lives under a team scope.
# Leave empty for personal-account projects. Format: team_<random>.
VERCEL_TEAM_ID=team_xxxxxxxxxx

# Bearer token rotation overlap window — populated automatically by
# api/cron/rotate-bearer during the 24h overlap, deleted by
# api/cron/invalidate-prev-bearer once the window closes.
# WARNING: keep empty in committed .env.example. Manually clearing this in
# Vercel does NOT trigger an alert; it just collapses the overlap to single-
# bearer mode (legacy WKH-65 behavior).
MCP_BEARER_TOKEN_PREV=

# === WKH-71 Operator/Relayer Native-Gas Monitor ===
#
# Separate concern from MCP_BALANCE_THRESHOLD_USDC above (that watches the MCP
# operator's USDC spend budget). This monitor (api/cron/gas-balance-check.mjs)
# watches whether operator/relayer wallets still hold enough NATIVE gas to
# broadcast settles on testnet. Alerts reuse MCP_ALERT_WEBHOOK_URL (same channel
# as the USDC alert). All config is env-driven — no wallet address or threshold
# is hardcoded in code (CD-6).

# Wallets to monitor — JSON array. Each entry: { label, address, chainIds[] }.
# `address` is a PUBLIC 0x address (read-only); NEVER put a private key here.
# `chainIds`: 43113=Fuji, 2368=Kite testnet, 84532=Base Sepolia.
# The two production wallets (settle facilitator + gateway operator) are the
# recommended default config — adjust chainIds to where each actually signs.
# If unset/empty → the monitor no-ops (warnOnce + 200), nothing is checked.
GAS_ALERT_TARGETS=[{"label":"facilitator-settle","address":"0x9c0638506F8C5fc44F0d8C7b9E9e267eA311BB5c","chainIds":[43113,2368,84532]},{"label":"gateway-operator","address":"0xf432baf1315ccDB23E683B95b03fD54Dd3e447Ba","chainIds":[43113,2368,84532]}]

# Per-chain WARNING/CRITICAL thresholds in NATIVE units (AVAX/KITE/ETH — no USD
# conversion, DT-1). Below CRITICAL → severity=critical; below WARNING (but
# above CRITICAL) → severity=warning. Non-finite/negative → conservative code
# default (shown). Override per chain without a redeploy.
# Fuji (AVAX) — default warning 0.5 / critical 0.1
WALLET_ALERT_THRESHOLD_FUJI_WARNING=0.5
WALLET_ALERT_THRESHOLD_FUJI_CRITICAL=0.1
# Kite testnet (KITE) — default warning 0.5 / critical 0.1
WALLET_ALERT_THRESHOLD_KITE_WARNING=0.5
WALLET_ALERT_THRESHOLD_KITE_CRITICAL=0.1
# Base Sepolia (ETH) — default warning 0.05 / critical 0.01
WALLET_ALERT_THRESHOLD_BASESEPOLIA_WARNING=0.05
WALLET_ALERT_THRESHOLD_BASESEPOLIA_CRITICAL=0.01

# Optional per-chain read-only RPC overrides. If unset, public testnet defaults
# are used (Fuji: api.avax-test.network, Kite: rpc-testnet.gokite.ai,
# Base Sepolia: sepolia.base.org).
# GAS_ALERT_RPC_43113=
# GAS_ALERT_RPC_2368=
# GAS_ALERT_RPC_84532=

# === WKH-77 Ecosystem Health Monitor (uptime + degraded-state alerting) ===
#
# Separate concern from the gas monitor above (that watches native-gas balances
# of signing wallets). THIS monitor (api/cron/health-check.mjs) HTTP-pings each
# ecosystem service's health endpoint and alerts on Discord when a service is
# down (non-2xx / unreachable / timeout) or logically degraded ({degraded:true}).
# Alerts reuse MCP_ALERT_WEBHOOK_URL + src/alerts.mjs::sendAlert (CD-1). All
# config is env-driven — no URL, tier or timeout is hardcoded in code (CD-3).

# Services to monitor — JSON array. Each entry:
#   { label, url, tier, mode?, degradedPath?, healthyField?, healthyValue?, logsUrl? }
#   - label:        unique human name (dedup key).
#   - url:          PUBLIC http(s) health endpoint (GET, redirects followed).
#   - tier:         "P0" | "P1" | "P2" → severity critical | warning | info.
#   - mode:         "status" (default) = expect HTTP 2xx; "reachability" = ANY
#                   HTTP response (incl. 404) counts as alive, only a
#                   connection-error/timeout is "down" (for endpoints with no
#                   public health route, e.g. an MCP server behind Bearer auth).
#   - degradedPath: dot-path into the 2xx JSON body that, when truthy, downgrades
#                   the service to a `warning` (P1) even on HTTP 200 (AC-3).
#   - healthyField / healthyValue: after a 2xx, require body[healthyField] ===
#                   healthyValue, else treat as down at the service tier.
#   - logsUrl:      static link to the Railway/Vercel logs dashboard (shown in
#                   the alert; NEVER a secret).
# If unset/empty → the monitor no-ops (warnOnce + 200), nothing is checked.
HEALTH_MONITOR_TARGETS=[{"label":"gateway-a2a","url":"https://wasiai-a2a-production.up.railway.app/health","tier":"P0","healthyField":"status","healthyValue":"ok","logsUrl":"https://railway.app/project/wasiai-a2a"},{"label":"facilitator","url":"https://wasiai-facilitator-production.up.railway.app/health","tier":"P0","degradedPath":"degraded","logsUrl":"https://railway.app/project/wasiai-facilitator"},{"label":"x402-mcp","url":"https://wasiai-x402-mcp.vercel.app/","tier":"P1","mode":"reachability","logsUrl":"https://vercel.com/wasiai/wasiai-x402-mcp/logs"},{"label":"app-wasiai","url":"https://app.wasiai.io/","tier":"P1","logsUrl":"https://vercel.com/wasiai/wasiai-v2/logs"}]

# Optional Discord push mention for P0 (critical) alerts. When set to a Discord
# mention token (`<@USER_ID>` for a user or `<@&ROLE_ID>` for a role), critical
# alerts get a root-level `content` field so Discord fires an actual PUSH
# notification (embeds alone do NOT notify). Unset → embed-only (no push),
# graceful. Applies to ANY critical alert through sendAlert (health + gas).
# Example: ONCALL_MENTION=<@123456789012345678>
ONCALL_MENTION=

# Per-request timeout for each outbound health check (ms). Default 5000, HARD
# CAPPED at 5000 (CD-6) so one hung service never blocks the others in a tick.
HEALTH_MONITOR_TIMEOUT_MS=5000
